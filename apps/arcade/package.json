{
    "name": "@scenic/arcade",
    "version": "0.0.0",
    "description": "Arcade for scenic: plays the games in games/",
    "dependencies": {
        "@scenic/dom": "*",
        "@scenic/renderer": "*",
        "@scenic/runtime": "*"
    },
    "devDependencies": {},
    "scripts": {
        "test": "echo no tests",
        "lint": "eslint ./",
        "build:bundle": "pakit --config .pakit-arcade.js",
        "build": "npm run build:bundle -- --minify false && npm run fingerprint",
        "build:prod": "npm run build:bundle -- --minify && npm run fingerprint",
        "fingerprint": "node ../../bin/fingerprint.js dist/arcade.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MiguelCastillo/scenic.git"
    },
