{
  "name": "scenic",
  "version": "0.0.0",
  "description": "Scene graph rendering",
  "main": "src/index.js",
  "scripts": {
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "perf": "node --expose-gc --min-semi-space-size=256 --max-semi-space-size=256 perf/run.js",
    "start": "npm start --workspace server",
    "start-dev": "pm2 start dev.config.js",
    "stop-dev": "pm2 delete server build fingerprint versions",
    "monit": "pm2 monit",
    "logs": "pm2 logs",
    "build": "node bin/build.js && node bin/fingerprint.js apps/arcade/dist/arcade.js apps/editor/dist/editor.js && node bin/version-games.js",
    "build:prod": "node bin/build.js --minify && node bin/fingerprint.js apps/arcade/dist/arcade.js apps/editor/dist/editor.js && node bin/version-games.js",
    "prepare": "husky install"
  },
  "author": "Miguel Castillo",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.2"
  },
  "dependencies": {
    "encoding": "^0.1.13",
    "iconoir-react": "^5.0.0",
    "node-fetch": "^3.2.6",
    "yargs": "^17.5.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.18.2",
    "@babel/preset-env": "^7.18.2",
    "@babel/preset-react": "^7.17.12",
    "esbuild": "0.28.2",
    "eslint": "^8.17.0",
    "eslint-plugin-react": "^7.30.0",
    "husky": "^8.0.1",
    "jest": "^28.1.1",
    "lint-staged": "^13.0.1",
    "pm2": "^5.2.0",
    "prettier": "2.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webgl-mock": "^0.1.7"
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  },
  "workspaces": [
    "packages/math",
    "packages/encoding/*",
    "packages/*",
    "apps/*",
    "server"
  ]
}
