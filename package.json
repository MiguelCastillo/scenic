{
  "name": "scenic",
  "version": "0.0.0",
  "description": "Scene graph rendering",
  "main": "src/index.js",
  "scripts": {
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "perf": "node --expose-gc --min-semi-space-size=256 --max-semi-space-size=256 perf/run.js",
    "start": "npm start --workspace server",
    "start-dev": "pm2 start dev.config.js",
    "stop-dev": "pm2 delete server build fingerprint versions",
    "monit": "pm2 monit",
    "logs": "pm2 logs",
    "build": "node bin/build.js && node bin/fingerprint.js apps/arcade/dist/arcade.js apps/editor/dist/editor.js && node bin/version-games.js",
    "build:prod": "node bin/build.js --minify && node bin/fingerprint.js apps/arcade/dist/arcade.js apps/editor/dist/editor.js && node bin/version-games.js",
    "prepare": "husky"
  },
  "author": "Miguel Castillo",
  "license": "MIT",
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  },
  "dependencies": {
    "iconoir-react": "^7.12.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pm2": "^7.1.1",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webgl-mock": "^0.1.7"
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write",
    "*.obj": "node bin/generate-obj-meta.js --check"
  },
  "workspaces": [
    "packages/math",
    "packages/encoding/*",
    "packages/*",
    "apps/*",
    "server"
  ]
}
