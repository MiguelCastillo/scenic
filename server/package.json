{
  "name": "@scenic/server",
  "version": "0.0.0",
  "private": true,
  "description": "The scenic server: the pages and files the apps load, and the rooms players race in",
  "type": "module",
  "main": "src/main.js",
  "dependencies": {
    "@scenic/racers": "*",
    "@scenic/runtime": "*",
    "ws": "8.22.0"
  },
  "scripts": {
